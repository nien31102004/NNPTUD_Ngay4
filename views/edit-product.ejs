<!DOCTYPE html>
<html>
<head>
  <title>Edit Product</title>
  <link rel="stylesheet" href="/stylesheets/style.css" />
</head>
<body>
  <h1>Edit Product</h1>
  <form action="/products/edit/<%= product._id %>" method="post">
    <label>Title: <input type="text" name="title" value="<%= product.title %>" required /></label><br />
    <label>Price: <input type="number" name="price" step="0.01" value="<%= product.price %>" /></label><br />
    <label>Description:<br /><textarea name="description"><%= product.description %></textarea></label><br />
    <label>Category ID: <input type="text" name="category" value="<%= product.category %>" /></label><br />
    <button type="submit">Save changes</button>
  </form>

  <p><a href="/products">Cancel</a></p>
</body>
</html>